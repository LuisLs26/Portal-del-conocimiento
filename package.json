{
  "name": "portal-del-conocimiento",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/sync-build.js",
    "preview": "vite preview",
    "test": "vitest run tests/rules.test.ts",
    "test:mobile": "playwright test",
    "typecheck": "tsc -p tsconfig.app.json",
    "typecheck:maraton": "tsc -p tsconfig.maraton.json",
    "test:maraton": "vitest run tests/maraton --maxWorkers=1",
    "dev:maraton": "wrangler dev --config wrangler.maraton.jsonc --port 8787",
    "deploy:maraton": "wrangler deploy --config wrangler.maraton.jsonc",
    "test:maraton:mobile": "playwright test --config playwright.maraton.config.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@playwright/test": "^1.64.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsqr": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "ws": "^8.22.0"
  }
}
